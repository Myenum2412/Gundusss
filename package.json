{
  "name": "fees-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:gateway": "npm --prefix payment-gateway run dev",
    "gateway:webhook": "npm --prefix payment-gateway run configure:fees-webhook",
    "gateway:install": "npm --prefix payment-gateway install",
    "build": "npm run build --workspaces"
  }
}
