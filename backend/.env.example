PORT=4000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Appwrite is the app's primary database.
# Create a server API key with these scopes:
#   databases.read, databases.write
#   tables.read, tables.write
#   columns.read, columns.write
#   rows.read, rows.write
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6adaf4be003ae5c9e622
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=fees

# YOUPI PG self-hosted payment gateway
YOUPI_PAYMENT_API_URL=http://localhost:6100
# Must match COIN_STORE_WEBHOOK_SECRET in payment-gateway/.env
YOUPI_WEBHOOK_SECRET=
# Must match ADMIN_API_TOKEN in payment-gateway/.env. Used by this backend to
# sync the merchant UPI ID, read payment status, and confirm/decline counter
# payments.
YOUPI_ADMIN_TOKEN=

# Legacy Postgres/PGlite connection. Only used by the one-time
# `npm run appwrite:migrate` import; the backend no longer reads it.
# DATABASE_URL=postgres://fees:fees@localhost:5432/fees
# Optional explicit source for `appwrite:migrate` (overrides DATABASE_URL):
# MIGRATE_DATABASE_URL=postgres://fees:fees@localhost:5432/fees
