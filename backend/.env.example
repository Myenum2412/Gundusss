PORT=4000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# Appwrite is the app's primary database.
# Create a server API key with these scopes:
#   databases.read, databases.write
#   tables.read, tables.write
#   columns.read, columns.write
#   rows.read, rows.write
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6adaf4be003ae5c9e622
# Never commit a real key. Create a server key in Appwrite and paste it only
# into backend/.env (which is gitignored).
APPWRITE_API_KEY=standard_your_appwrite_server_api_key
APPWRITE_DATABASE_ID=fees

# Signs the stateless session tokens issued at login. Set this to a long random
# string (for example `openssl rand -hex 32`). If omitted, the Appwrite API key
# is used as a fallback so existing installs keep working, but changing the
# Appwrite key would invalidate every session.
AUTH_SECRET=
# Session lifetime in hours (default: 12).
AUTH_TOKEN_TTL_HOURS=12

# YOUPI PG self-hosted payment gateway
YOUPI_PAYMENT_API_URL=http://localhost:6100
# Public origin of the YOUPI checkout portal, used to build the checkout links
# shown to staff and students. Set this in production (for example
# https://pay.myenum.in) when the gateway advertises a loopback URL behind a
# reverse proxy. Leave empty locally to use the gateway-provided URL.
YOUPI_PUBLIC_CHECKOUT_URL=
# Must match COIN_STORE_WEBHOOK_SECRET in payment-gateway/.env
YOUPI_WEBHOOK_SECRET=
# Shared secret for the payment gateway -> fees WhatsApp bridge
# (POST /api/whatsapp/internal/send). When empty, YOUPI_WEBHOOK_SECRET is used,
# so the gateway's existing COIN_STORE_WEBHOOK_SECRET works out of the box.
WHATSAPP_BRIDGE_TOKEN=
# Must match ADMIN_API_TOKEN in payment-gateway/.env. Used by this backend to
# sync the merchant UPI ID, read payment status, and confirm/decline counter
# payments.
YOUPI_ADMIN_TOKEN=

# cron-job.org REST API key — required by the monthly reminder cron
CRONJOB_API_KEY=

# Shared secret cron-job.org must send as the X-Cron-Key header on the
# /api/reminders/cron/monthly webhook (set the same header on the cron job).
CRON_WEBHOOK_SECRET=

# Reminder queue worker (must match WORKER_SECRET in queue-worker/.env).
# When set (and WhatsApp is connected), reminder runs are queued and delivered
# by the independent Python worker instead of inline sends.
WORKER_SECRET=

# WhatsApp send pacing (anti-ban safety net behind the worker's own pacing).
# Minimum gap between two outgoing messages + extra random jitter, in ms.
WA_SEND_GAP_MS=8000
WA_SEND_JITTER_MS=7000

# Hard timeout for a WhatsApp engine connect attempt, in ms.
WA_INIT_TIMEOUT_MS=90000
