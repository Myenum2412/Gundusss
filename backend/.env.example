PORT=4000
HOST=0.0.0.0
DATABASE_URL=postgres://fees:fees@localhost:5432/fees
FRONTEND_URL=http://localhost:3000

# YOUPI PG self-hosted payment gateway
YOUPI_PAYMENT_API_URL=http://localhost:6100
# Must match COIN_STORE_WEBHOOK_SECRET in payment-gateway/.env
YOUPI_WEBHOOK_SECRET=
# Must match ADMIN_API_TOKEN in payment-gateway/.env. Used by this backend to
# sync the merchant UPI ID, read payment status, and confirm/decline counter
# payments.
YOUPI_ADMIN_TOKEN=

# Optional Appwrite data mirror. Postgres stays the source of truth; every
# successful write is mirrored to one Appwrite collection as a full snapshot.
# Leave APPWRITE_API_KEY empty to keep the mirror disabled.
APPWRITE_ENDPOINT=https://nyc.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6adaf4be003ae5c9e622
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=fees
APPWRITE_STATE_COLLECTION_ID=app_state
