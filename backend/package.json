{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pglite-server --db=./.pgdata --port=5433 --max-connections=10 --include-database-url --run \"node --watch --import tsx src/server.ts\"",
    "dev:pg": "tsx watch src/server.ts",
    "build": "tsc",
    "prestart": "node scripts/prestart.mjs",
    "start": "pglite-server --db=./.pgdata --port=5433 --max-connections=10 --include-database-url --run \"node dist/server.js\"",
    "start:app": "node dist/server.js",
    "appwrite:setup": "node scripts/setup-appwrite.mjs",
    "db:migrate": "psql $DATABASE_URL -f ./sql/init.sql"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@electric-sql/pglite-socket": "^0.2.14",
    "@fastify/cors": "^10.0.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
